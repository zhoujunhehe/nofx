# ═══════════════════════════════════════════════════════════════
# NOFX Railway Deployment Dockerfile
# Combined Backend + Frontend for single container deployment
# ═══════════════════════════════════════════════════════════════

ARG GO_VERSION=1.25-alpine
ARG NODE_VERSION=20-alpine
ARG ALPINE_VERSION=latest
ARG TA_LIB_VERSION=0.4.0

# ──────────────────────────────────────────────────────────────
# Stage 1: Build TA-Lib
# ──────────────────────────────────────────────────────────────
FROM alpine:${ALPINE_VERSION} AS ta-lib-builder
ARG TA_LIB_VERSION

RUN apk update && apk add --no-cache \
    wget tar make gcc g++ musl-dev autoconf automake

RUN wget http://prdownloads.sourceforge.net/ta-lib/ta-lib-${TA_LIB_VERSION}-src.tar.gz && \
    tar -xzf ta-lib-${TA_LIB_VERSION}-src.tar.gz && \
    cd ta-lib && \
    if [ "$(uname -m)" = "aarch64" ]; then \
        CONFIG_GUESS=$(find /usr/share -name config.guess | head -1) && \
        CONFIG_SUB=$(find /usr/share -name config.sub | head -1) && \
        cp "$CONFIG_GUESS" config.guess && \
        cp "$CONFIG_SUB" config.sub && \
        chmod +x config.guess config.sub; \
    fi && \
    ./configure --prefix=/usr/local && \
    make && make install && \
    cd .. && rm -rf ta-lib ta-lib-${TA_LIB_VERSION}-src.tar.gz

# ──────────────────────────────────────────────────────────────
# Stage 2: Build Frontend (React + Vite)
# ──────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS frontend-builder

WORKDIR /build

# Copy frontend package files
COPY web/package*.json ./
RUN npm ci

# Copy frontend source and build
COPY web/ ./
RUN npm run build

# ──────────────────────────────────────────────────────────────
# Stage 3: Build Backend (Go)
# ──────────────────────────────────────────────────────────────
FROM golang:${GO_VERSION} AS backend-builder

RUN apk update && apk add --no-cache git make gcc g++ musl-dev

# Copy TA-Lib from first stage
COPY --from=ta-lib-builder /usr/local /usr/local

WORKDIR /app

# Copy Go module files
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build
COPY . .
RUN CGO_ENABLED=1 GOOS=linux \
    CGO_CFLAGS="-D_LARGEFILE64_SOURCE" \
    go build -trimpath -ldflags="-s -w" -o nofx .

# ──────────────────────────────────────────────────────────────
# Stage 4: Runtime (Backend + Frontend Static Files + Nginx)
# ──────────────────────────────────────────────────────────────
FROM alpine:${ALPINE_VERSION}

# Install runtime dependencies
RUN apk update && apk add --no-cache \
    ca-certificates \
    tzdata \
    nginx \
    curl \
    && rm -rf /var/cache/apk/*

# Copy TA-Lib libraries
COPY --from=ta-lib-builder /usr/local /usr/local

# Setup working directory
WORKDIR /app

# Copy backend binary
COPY --from=backend-builder /app/nofx .

# Copy prompts directory
COPY prompts ./prompts

# Copy frontend build to Nginx html directory
COPY --from=frontend-builder /build/dist /usr/share/nginx/html

# Copy Railway-specific Nginx configuration
COPY nginx/nginx-railway.conf /etc/nginx/conf.d/default.conf

# Create necessary directories
RUN mkdir -p /app/decision_logs /app/secrets /run/nginx

# Set permissions
RUN chmod +x /app/nofx

# Create startup script that handles Railway's PORT environment variable
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'echo "🚀 Starting NOFX AI Trading System on Railway..."' >> /app/start.sh && \
    echo '' >> /app/start.sh && \
    echo '# Use Railway PORT or default to 8080' >> /app/start.sh && \
    echo 'export PORT=${PORT:-8080}' >> /app/start.sh && \
    echo 'echo "📡 Port: $PORT"' >> /app/start.sh && \
    echo '' >> /app/start.sh && \
    echo '# Update Nginx to listen on Railway PORT' >> /app/start.sh && \
    echo 'sed -i "s/listen 80;/listen $PORT;/" /etc/nginx/conf.d/default.conf' >> /app/start.sh && \
    echo '' >> /app/start.sh && \
    echo 'echo "📁 Creating necessary directories..."' >> /app/start.sh && \
    echo 'mkdir -p /app/decision_logs' >> /app/start.sh && \
    echo '' >> /app/start.sh && \
    echo 'echo "🌐 Starting Nginx on port $PORT..."' >> /app/start.sh && \
    echo 'nginx' >> /app/start.sh && \
    echo '' >> /app/start.sh && \
    echo 'echo "🤖 Starting Backend on port 8080..."' >> /app/start.sh && \
    echo 'exec /app/nofx' >> /app/start.sh && \
    chmod +x /app/start.sh

# Expose default port (Railway will override with PORT env var)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/api/health || exit 1

# Start both Nginx and Backend
CMD ["/app/start.sh"]
